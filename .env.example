# MQTT
MQTT_HOST=mqtt
MQTT_PORT=1883

# Services internes (réseau Docker)
TELEMETRY_URL=http://telemetry:8003
LLM_URL=http://llm:8001

# Ollama (service Docker local, modèle léger pour tests)
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=phi4-mini
OLLAMA_CONTEXT_LENGTH=8192

# Ollama (serveur distant sur le LAN — décommenter pour rebasculer)
# OLLAMA_URL=http://192.168.1.16:11434
# OLLAMA_MODEL=VladimirGav/gemma4-26b-16GB-VRAM:latest
